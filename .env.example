# ============================================================================
# Luminus Proposal System + CRM — environment template
# Copy to ".env" on the server (chmod 600). NEVER commit the real file.
# Every value below is a PLACEHOLDER. Names that start with VITE_ are compiled
# into the browser bundle — only put PUBLIC values behind a VITE_ name.
# ============================================================================

# ---- Staff login (Proposal System) -----------------------------------------
# Shared staff password. Use a long random value and rotate when people leave.
ADMIN_BYPASS_PASSWORD=change-me-long-random-password
VITE_ADMIN_BYPASS_MODE=true

# ---- Supabase (database + file storage) ------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# public "anon" key (limited by database permissions)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# SECRET master key — server only, never use a VITE_ name for it
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Lead sources (Airtable) ------------------------------------------------
# One personal access token reads all four bases. Keep calls ~4/day (see docs).
CRM_API_TOKEN=your-airtable-personal-access-token
CRM_SOURCE_1_LABEL=Brown
CRM_SOURCE_1_BASE_ID=appXXXXXXXXXXXXXX
CRM_SOURCE_1_TABLE_ID=tblXXXXXXXXXXXXXX
CRM_SOURCE_2_LABEL=Black
CRM_SOURCE_2_BASE_ID=appXXXXXXXXXXXXXX
CRM_SOURCE_2_TABLE_ID=tblXXXXXXXXXXXXXX
CRM_SOURCE_3_LABEL=Blue
CRM_SOURCE_3_BASE_ID=appXXXXXXXXXXXXXX
CRM_SOURCE_3_TABLE_ID=tblXXXXXXXXXXXXXX
CRM_SOURCE_4_LABEL=White
CRM_SOURCE_4_BASE_ID=appXXXXXXXXXXXXXX
CRM_SOURCE_4_TABLE_ID=tblXXXXXXXXXXXXXX
# folder of the Python lead engine (migrate.py)
MIGRATION_SCRIPT_DIR=/opt/lead-import

# ---- Gemini (AI that reads proposal PDFs) -----------------------------------
# Free-tier keys are tried first (in order), the paid key last.
VITE_GEMINI_API_KEY=your-gemini-key-1
VITE_GEMINI_API_KEY_2=your-gemini-key-2
VITE_GEMINI_API_KEY_3=your-gemini-key-3
VITE_GEMINI_API_KEY_TIER1=your-paid-gemini-key

# ---- Mailbox (sending AND reading mail) -------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=mailbox@your-domain.example
SMTP_PASS=your-mailbox-password
SMTP_FROM_NAME=Your Company
# IMAP_HOST=imap.hostinger.com   (default)

# ---- n8n <-> app ------------------------------------------------------------
# shared secret that n8n sends in the X-CRM-Ingest-Key header (use: openssl rand -hex 32)
CRM_INGEST_KEY=change-me-random-hex
N8N_GOOGLE_SYNC_WEBHOOK=https://n8n.your-domain.example:8443/webhook/google-sync
N8N_FOLLOWUP_WEBHOOK=https://n8n.your-domain.example:8443/webhook/followup-sent

# ---- Background workers (set ONLY on the production server) ------------------
# Sends queued client announcements (max 30/hour). Leave unset on staging/dev.
CRM_BROADCAST_WORKER=true
# Read-only e-mail safety net (after the "deploy 3" update). Leave unset on staging/dev.
# CRM_INBOX_RECONCILE=true

# ---- Google Drive copy of every lead (rclone) --------------------------------
RCLONE_DRIVE_ENABLED=true

# ---- Optional / legacy -------------------------------------------------------
# AI Studio image panel (not used in the daily flow)
# REPLICATE_API_TOKEN=
# VITE_REPLICATE_MODEL_ID=
# STRIPE_SECRET_KEY=            (not configured — payment links are pasted by hand)
# PORT=3001                     (production is set by ecosystem.config.cjs)
