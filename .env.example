# ========================================
# AUTHENTICATION
# ========================================

# Bypass Mode (no database needed)
VITE_ADMIN_BYPASS_MODE=true
VITE_ADMIN_BYPASS_PASSWORD=YourPassword123

# Supabase (optional - for production with database)
VITE_SUPABASE_URL=https://gfpogtqkoavdczomgnpz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# REPLICATE AI - READ THIS CAREFULLY!
# ========================================

# ⚠️  SECURITY: Do NOT use VITE_REPLICATE_API_TOKEN — the VITE_ prefix
#     exposes this key to the browser bundle. Use REPLICATE_API_TOKEN (below)
#     and access it only via the Express server (server.js).
#     The old VITE_ key is kept here temporarily for backwards-compat but
#     will be removed in Phase 3.
REPLICATE_API_TOKEN=your_replicate_api_token_here
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# ----------------------------------------
# OPTION 1: YOUR PRIVATE CUSTOM MODEL
# ----------------------------------------
# ⚠️ ONLY USE IF YOU OWN THIS MODEL OR HAVE ACCESS!
# If model is private and you don't have access, this will fail!

VITE_REPLICATE_MODEL_ID=t442t7vc4nrmr0cw581rq1vca0
VITE_REPLICATE_VERSION_ID=a6f669a29b27c0ddb6e6ef8dc9dc3a09f2d08e8d75c2cb8c67c1a2175d1815e3

# ----------------------------------------
# OPTION 2: PUBLIC MODEL FOR TESTING
# ----------------------------------------
# ✅ RECOMMENDED: Test with public model FIRST to confirm setup works
# Then switch to your custom model after verifying everything else is working
#
# To use: Comment out OPTION 1 above, uncomment ONE of these:

# FLUX Schnell (Fast & Free - Good for testing)
# VITE_REPLICATE_MODEL_ID=black-forest-labs/flux-schnell
# VITE_REPLICATE_VERSION_ID=bf96d3e8a2e42b8e3d90fa4d1ad28097e9e67a4ac3cf3db34db7e42d6dc5b0bb

# SDXL (High Quality)
# VITE_REPLICATE_MODEL_ID=stability-ai/sdxl
# VITE_REPLICATE_VERSION_ID=39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b

# ========================================
# GOOGLE GEMINI AI (FREE TIER AVAILABLE)
# ========================================
# Get your API key from: https://aistudio.google.com/app/apikey (Google AI Studio, not Cloud Console —
# the AI Studio free tier is the generous one, ~500 images/day per account, no card required)
# Model used: gemini-2.5-flash-image ("Nano Banana")
# Features: Text-to-image, Image-to-image, Auto prompt enhancement
#
# Optional: add up to 2 more accounts (_2, _3) — the backend rotates between them automatically
# when one hits a rate limit or daily quota, so 3 accounts ~= 1,500 free images/day combined.

VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY_2=your_second_gemini_api_key_here
VITE_GEMINI_API_KEY_3=your_third_gemini_api_key_here

# ========================================
# IMAGINE.ART (CREDIT-BASED)
# ========================================
# Get your API key from: https://www.imagine.art/dashboard/api
# Pricing: Buy credits, ~$0.10-0.60 per image depending on model
# Features: High-quality image generation, multiple models

VITE_IMAGINEART_API_KEY=your_imagineart_api_key_here

# ========================================
# HUGGING FACE (FREE TIER AVAILABLE)
# ========================================
# Get your token from: https://huggingface.co/settings/tokens
# Free tier: Rate limited, slower generation
# Features: Open-source models, experimentation

VITE_HUGGINGFACE_API_KEY=your_huggingface_token_here

# ========================================
# AUTOMATION WEBHOOKS (N8n or Activepieces)
# ========================================

# For Emails (N8N webhook)
# IMPORTANT: On Vercel, add this as N8N_EMAIL_WEBHOOK (without VITE_ prefix)
# so the serverless function can read it. VITE_ vars are frontend-only on Vercel.
VITE_N8N_EMAIL_WEBHOOK=https://your-n8n-instance.com/webhook/email-pdf
N8N_EMAIL_WEBHOOK=https://your-n8n-instance.com/webhook/email-pdf

# For Payments
VITE_N8N_PAYMENT_WEBHOOK=https://your-n8n-instance.com/webhook/payment-link

# ========================================
# HOW TO GET API KEYS
# ========================================
#
# GEMINI (FREE - Recommended to start):
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key and paste above
# 4. Free tier: 500 images/day
#
# IMAGINE.ART (Credits):
# 1. Go to: https://www.imagine.art
# 2. Sign up/login
# 3. Dashboard → API section
# 4. Generate API key
# 5. Purchase credits
# 6. Copy key and paste above
#
# HUGGING FACE (FREE):
# 1. Go to: https://huggingface.co
# 2. Sign up/login
# 3. Settings → Access Tokens
# 4. Create new token (Read permission)
# 5. Copy token and paste above
#
# ========================================
# TROUBLESHOOTING MODEL ACCESS
# ========================================
# If you get errors when using AI regeneration:
#
# 1. Test API token:
#    curl -X GET https://api.replicate.com/v1/account \
#      -H "Authorization: Token YOUR_TOKEN"
#
# 2. Check if model is accessible:
#    curl -X GET https://api.replicate.com/v1/models/OWNER/MODEL_NAME \
#      -H "Authorization: Token YOUR_TOKEN"
#
# 3. Try creating a prediction:
#    See MODEL_ACCESS_DIAGNOSTIC.md for detailed tests
#
# 4. If private model fails, try public model first to isolate issue
#
# FOR NEW AI PROVIDERS:
# - Gemini: Check console for error messages
# - Imagine.art: Verify credits are available
# - Hugging Face: Models may take time to load (cold start)

# ========================================
# N8N INTEGRATION (Optional)
# ========================================
# For payment processing and Google Sheets integration

# N8N Webhook for Payment Processing
# 1. Create an N8N workflow with Webhook trigger
# 2. Copy the webhook URL (Production URL)
# 3. Paste here:
VITE_N8N_PAYMENT_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/payment

# N8N Webhook for Google Sheets Data Export
# 1. Create N8N workflow: Webhook → Google Sheets (Append Row)
# 2. Configure Google Sheets node with your spreadsheet
# 3. Paste webhook URL here:
VITE_N8N_SHEETS_WEBHOOK=https://your-n8n-instance.app.n8n.cloud/webhook/sheets

# Column mapping for Google Sheets:
# - Column A: Name (client name)
# - Column B: Price (first price from pricing table)
# - Column C: Size (dimensions)
# - Column D: Image (image URL if available)
# - Column E: Timestamp


# ========================================
# BULK AUTOMATION — PHASE 0 / 1
# ========================================

# Supabase Service Role key (server-side only — never use VITE_ prefix here)
# Get from: Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Replicate API token (server-side only — no VITE_ prefix)
# Same token as above, just referenced without the VITE_ prefix
# so it is never bundled into the frontend JS.
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Primary image generation model (Nano Banana Pro)
REPLICATE_MODEL_PRIMARY=black-forest-labs/flux-schnell

# Fallback image generation model (GPT Image 2 via Replicate)
REPLICATE_MODEL_FALLBACK=openai/gpt-image-2

# Max concurrent image generation jobs (keep at 5 to avoid rate limits)
IMAGE_GEN_CONCURRENCY=5

# Optional: customize the AI image generation prompt.
# Use {{signType}} and {{size}} placeholders. The original PDF image is used as a reference
# with low prompt strength so the sign text and layout are preserved.
# REPLICATE_IMAGE_PROMPT_TEMPLATE=Professional photorealistic storefront mockup of a {{signType}} sign{{size}}. Preserve the exact text, font, lettering, and layout of the original sign. Only update the surrounding scene, lighting, and materials to create a polished, commercial presentation. High quality, sharp details, clean composition, no extra text, no distorted letters.

# ----------------------------------------
# SERVER-SIDE PDF GENERATION (PHASE 4)
# ----------------------------------------
# Used by Puppeteer to know which domain to visit to generate PDFs
FRONTEND_URL=http://localhost:3000
