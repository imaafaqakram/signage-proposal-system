# N8N Self-Hosted — VPS Environment Variables
# Copy this to .env alongside docker-compose.yml on your VPS

# PostgreSQL password (use a strong random string)
POSTGRES_PASSWORD=replace_with_strong_password_here

# N8N admin login
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD=replace_with_strong_password_here

# Your domain (after setting up HTTPS with nginx/caddy)
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com
